# Morgan (heymorgan) on the home server — reference template, as Brigid's is.
#
# It runs from its project checkout, as the other web apps there do. Replace:
#   User=             the account that owns the checkout
#   WorkingDirectory= the absolute checkout path
#   ExecStart=        the checkout path again (and node's, from `command -v node`)
#   ReadWritePaths=   the checkout path once more, and the home folder's
# The port is in .env in the checkout (see .env.example).

[Unit]
Description=heymorgan — Morgan's brain, serving its clients
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/heymorgan
ExecStart=/usr/bin/node /home/YOUR_USER/heymorgan/daemon.mjs
# Saving some settings asks for a restart, which it does by exiting.
Restart=always
RestartSec=3
Environment=NODE_ENV=production
# `claude` (the Oracle) and anything installed for the account.
Environment=PATH=/home/YOUR_USER/.local/bin:/usr/local/bin:/usr/bin:/bin

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# The parents of its folders, not the folders: the first start after the
# rename moves ~/.config/heyclaude and ~/.local/share/heyclaude to heymorgan.
# A "-" lets it start where one of them is missing.
ReadWritePaths=/home/YOUR_USER/heymorgan -/home/YOUR_USER/.config -/home/YOUR_USER/.local/share

[Install]
WantedBy=multi-user.target
Alias=heyclaude.service
